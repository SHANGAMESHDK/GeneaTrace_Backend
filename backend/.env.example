# ==============================================================================
# GENEATRACE BACKEND ENVIRONMENT CONFIGURATION
# Production Target: Azure App Service (Linux, Python) + Supabase Managed PostgreSQL
# ==============================================================================

# Application Environment (production, staging, development, test)
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. Relational Database: Supabase Managed PostgreSQL
# ------------------------------------------------------------------------------
# For Direct Connection (IPv6 supported):
# DATABASE_URL=postgresql://postgres.yourproject:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# For Supabase Session / Transaction Pooler (PgBouncer, Port 6543):
# DATABASE_URL=postgresql://postgres.yourproject:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# For Local Development / Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geneatrace

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 2. Graph Database: Neo4j (Separately hosted or AuraDB)
# ------------------------------------------------------------------------------
# Set to false to activate the transparent PostgreSQL recursive query fallback
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
# For Neo4j Aura Cloud:
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=geneatracepassword

# ------------------------------------------------------------------------------
# 3. Blockchain Layer: EVM Smart Contract & RPC
# ------------------------------------------------------------------------------
# Set to false to use the local in-memory MockBlockchainAdapter
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Contract address after deploying contracts/contracts/GeneaTraceRegistry.sol:
BLOCKCHAIN_CONTRACT_ADDRESS=
# Authorized issuer private key (DO NOT commit real keys; store in Azure Key Vault in production):
BLOCKCHAIN_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT & RBAC)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-very-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. CORS Settings (Allowed Frontend Origins)
# ------------------------------------------------------------------------------
# Comma-separated list of origins permitted to communicate with backend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-frontend-domain.azureedge.net"]

# ------------------------------------------------------------------------------
# 6. Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
