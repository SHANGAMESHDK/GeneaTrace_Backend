PORT=8080
# Supabase Postgres connection string (Project Settings → Database → Connection string → URI).
# Empty = local JSON file store (server/data/local-ledger.json).
DATABASE_URL=
# 32+ random bytes. All signing keys derive from this – never rotate once the chain has data.
LEDGER_SECRET=
ADMIN_API_KEY=change-me
# Password for the "admin" username on the sign-in page (empty = API key only)
ADMIN_PASSWORD=
# true exposes demo logins on the sign-in page. Set false in production.
DEMO_MODE=true
POW_DIFFICULTY=3
# Public URL of the web app – encoded into every QR label.
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=*

# ── Ethereum anchoring (optional) ─────────────────────────────────────────────
# All three set = every ledger block hash is anchored to the GeneaTraceAnchor contract.
# Local chain: run `npm run chain:node` and `npm run chain:deploy` – the deploy fills these in.
# Sepolia: RPC URL from your provider, the contract owner's private key, and the deployed address.
ETH_RPC_URL=
ETH_PRIVATE_KEY=
ETH_CONTRACT_ADDRESS=
ETH_CHAIN_ID=
# Block explorer base URL (defaults: Sepolia/mainnet Etherscan)
ETH_EXPLORER_URL=
ETH_ANCHOR_INTERVAL_MS=5000
ETH_ANCHOR_BATCH=50
